{
  "name": "jsengine",
  "version": "0.1.0",
  "description": "Console-rendered ECS game engine, runs on node and bun",
  "type": "commonjs",
  "main": "dist/engine/index.js",
  "types": "dist/engine/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "bun scripts/runChecks.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build:library": "tsc -p tsconfig.json",
    "run:node": "node -r ts-node/register/transpile-only",
    "test": "bun test",
    "test:unit:bun": "bun test",
    "test:unit:node": "node -r ts-node/register/transpile-only scripts/runNodeUnitTests.js",
    "test:integration:bun": "bun scripts/runIntegrationTests.ts",
    "test:integration:node": "node -r ts-node/register/transpile-only scripts/runIntegrationTests.ts",
    "test:frame-hashes": "bun tests/checkFrameHashes.ts",
    "test:frame-hashes:update-baseline": "bun tests/checkFrameHashes.ts --update-baseline",
    "demo:2d:bun": "bun demo/2d/index.ts",
    "demo:2d:node": "node -r ts-node/register/transpile-only demo/2d/index.ts",
    "demo:3d:bun": "bun demo/3d/index.ts",
    "demo:3d:node": "node -r ts-node/register/transpile-only demo/3d/index.ts",
    "demo:2d:web": "bun scripts/serveWeb.ts 2d",
    "demo:3d:web": "bun scripts/serveWeb.ts 3d",
    "demo:2d:window": "bun scripts/launchWindow.ts 2d",
    "demo:3d:window": "bun scripts/launchWindow.ts 3d",
    "web:build-dev": "bun scripts/buildWeb.ts",
    "bench:spatial-index:bun": "bun bench/spatialIndex.bench.ts",
    "bench:spatial-index:node": "node -r ts-node/register/transpile-only bench/spatialIndex.bench.ts",
    "bench:frame-time:bun": "bun bench/boundsCascade.bench.ts",
    "bench:frame-time:node": "node -r ts-node/register/transpile-only bench/boundsCascade.bench.ts",
    "bench:structural-changes:bun": "bun bench/structural.bench.ts",
    "bench:structural-changes:node": "node --expose-gc -r ts-node/register/transpile-only bench/structural.bench.ts",
    "web:build-prod": "bun scripts/buildWeb.ts --prod",
    "web:serve-dev": "bun scripts/serveWeb.ts",
    "web:serve-prod": "bun scripts/serveWeb.ts --prod",
    "window:smoke-test": "bun scripts/launchWindow.ts 2d --smoke && bun scripts/launchWindow.ts 3d --smoke --no-build",
    "window:package-2d": "bun scripts/packageWindow.ts 2d",
    "window:package-3d": "bun scripts/packageWindow.ts 3d",
    "logs:clear": "bun scripts/clearLogs.js",
    "scriptc:measure-coverage": "scriptc coverage scripts/scriptcCoverageEntry.ts",
    "texture:generate-checker": "bun scripts/generateCheckerTexture.ts"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@types/bun": "^1.2.23",
    "@types/node": "^24.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
