{
  "name": "jsengine",
  "version": "0.1.0",
  "description": "Console-rendered ECS game engine, runs on node and bun",
  "author": "Xavier Tay",
  "private": true,
  "type": "commonjs",
  "main": "dist/engine/index.js",
  "types": "dist/engine/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "src/engine",
    "src/backends",
    "src/hosts",
    "src/editor",
    "src/toolchain"
  ],
  "scripts": {
    "check": "bun scripts/runChecks.ts",
    "check:release": "bun scripts/runChecks.ts --release",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "build:library": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:node": "node -r ts-node/register/transpile-only scripts/runNodeUnitTests.js",
    "test:integration": "bun scripts/runIntegrationTests.ts",
    "test:integration:node": "node -r ts-node/register/transpile-only scripts/runIntegrationTests.ts",
    "test:frame-hashes": "bun tests/checkFrameHashes.ts",
    "test:demo-frame-hashes": "bun tests/checkDemoFrameHashes.ts",
    "test:bundles": "bun src/toolchain/cli.ts build --report bundles",
    "jsengine": "bun src/toolchain/cli.ts",
    "demo": "bun src/toolchain/cli.ts run",
    "editor": "bun src/toolchain/cli.ts edit",
    "smoke": "bun scripts/smokeTests.ts",
    "web:build": "bun src/toolchain/cli.ts build --target web",
    "web:serve": "bun src/toolchain/cli.ts serve",
    "web:deploy": "bun src/toolchain/cli.ts build --target web --prod && bunx wrangler pages deploy",
    "window:package": "bun src/toolchain/cli.ts package --target window"
  },
  "dependencies": {
    "@jsengine/backends": "workspace:*",
    "@jsengine/editor": "workspace:*",
    "@jsengine/engine": "workspace:*",
    "@jsengine/hosts": "workspace:*",
    "@jsengine/toolchain": "workspace:*"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@types/bun": "^1.2.23",
    "@types/node": "^24.2.1",
    "@webgpu/types": "^0.1.74",
    "electron": "^44.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
