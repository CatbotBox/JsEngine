{
  "name": "jsengine",
  "version": "0.1.0",
  "description": "Console-rendered ECS game engine, runs on node and bun",
  "type": "commonjs",
  "main": "dist/js_engine/index.js",
  "types": "dist/js_engine/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "ts": "node -r ts-node/register/transpile-only",
    "ts:bun": "bun",
    "test": "node -r ts-node/register/transpile-only scripts/runTests.js",
    "test:bun": "bun test",
    "demo": "node -r ts-node/register/transpile-only demo/2d/index.ts",
    "demo:3d": "node -r ts-node/register/transpile-only demo/3d/index.ts",
    "demo:bun": "bun demo/2d/index.ts",
    "demo:3d:bun": "bun demo/3d/index.ts",
    "demo:3d:scriptc": "scriptc run demo/3d/index.ts",
    "verify": "node -r ts-node/register/transpile-only tests/verifyWorld.ts && node -r ts-node/register/transpile-only tests/verifyThreading.ts && node -r ts-node/register/transpile-only tests/verifyDemo2d.ts && node -r ts-node/register/transpile-only tests/verifyDemo3d.ts && node -r ts-node/register/transpile-only tests/verifyWorldWorker.ts",
    "verify:bun": "bun tests/verifyWorld.ts && bun tests/verifyThreading.ts && bun tests/verifyDemo2d.ts && bun tests/verifyDemo3d.ts && bun tests/verifyWorldWorker.ts",
    "bench": "node -r ts-node/register/transpile-only bench/spatialIndex.bench.ts",
    "bench:cascade": "node -r ts-node/register/transpile-only bench/boundsCascade.bench.ts",
    "bench:cascade:bun": "bun bench/boundsCascade.bench.ts",
    "bench:bun": "bun bench/spatialIndex.bench.ts",
    "bench:structural": "node --expose-gc -r ts-node/register/transpile-only bench/structural.bench.ts",
    "bench:structural:bun": "bun bench/structural.bench.ts",
    "scriptc:coverage": "scriptc coverage scripts/scriptcProbe.ts",
    "clear-logs": "node scripts/clearLogs.js",
    "clear-logs:bun": "bun scripts/clearLogs.js",
    "web:build": "bun scripts/buildWeb.ts",
    "web:build:prod": "bun scripts/buildWeb.ts --prod",
    "web": "bun scripts/serveWeb.ts",
    "web:prod": "bun scripts/serveWeb.ts --prod",
    "window": "bun scripts/window.ts 2d",
    "window:3d": "bun scripts/window.ts 3d",
    "window:smoke": "bun scripts/window.ts 2d --smoke && bun scripts/window.ts 3d --smoke --no-build",
    "window:package": "bun scripts/packageWindow.ts"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@types/bun": "^1.2.23",
    "@types/node": "^24.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
